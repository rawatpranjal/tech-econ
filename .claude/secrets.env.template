# Copy this to secrets.env and fill in your keys
# NEVER commit secrets.env - it's gitignored

# OpenAI API (for LLM enrichment)
OPENAI_API_KEY=sk-proj-xxx

# Cloudflare (for analytics worker)
CLOUDFLARE_API_TOKEN=xxx
CLOUDFLARE_ACCOUNT_ID=e53411f5363195f142c4b30558be082a

# Worker-side admin key (set on the worker via `wrangler secret put ADMIN_KEY`).
# Optional locally -- needed only when you want the eval gate to fetch
# sessions via the HTTP /events-raw endpoint instead of the wrangler
# subprocess. When unset, the gate falls back to wrangler automatically.
# Used by:
#   /run-schema?key=$ADMIN_KEY     -- replay schema migrations
#   /events-raw?key=$ADMIN_KEY     -- raw events for offline eval
ADMIN_KEY=xxx

# GitHub (for automation)
GITHUB_PAT=ghp_xxx

# Anthropic/Claude (for enrichment)
ANTHROPIC_API_KEY=sk-ant-xxx

# Brave Search (for content discovery - free tier: 2000/month)
BRAVE_API_KEY=xxx

# Tavily Search (for content discovery - free tier: 1000/month)
TAVILY_API_KEY=xxx
