# Hugo build output
public/
resources/_gen/

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Hugo lock file
.hugo_build.lock
node_modules/
scripts/__pycache__/
# Secrets - NEVER COMMIT
.claude/secrets.env
.env
secrets.*
!*.template

# Discovery crawler state (operational, not content)
data/.discovery_state.json
data/.discovery_rejected.json
data/.discovery_digest.html
data/.discovery_paper_staging.json

# Book PDFs - keep markdown output, never commit the binaries
books/**/source.pdf

# D1 dumps — contain IPs and weak user IDs, never commit
analytics-worker/backups/
