# Hugo build output
public/
resources/_gen/

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Hugo lock file
.hugo_build.lock
node_modules/
**/__pycache__/
# Secrets - NEVER COMMIT
.claude/secrets.env
.env
secrets.*
!*.template
# Local one-off secret files (per CLAUDE.md, secrets belong in .claude/secrets.env)
cloudflaretoken.txt

# Versioned model artifacts (Ra7) — local cache, regenerated by /rerank
data/.model_cache/

# Discovery crawler state (operational, not content)
data/.discovery_state.json
data/.discovery_rejected.json
data/.discovery_digest.html
data/.discovery_paper_staging.json

# Book PDFs - keep markdown output, never commit the binaries
books/**/source.pdf

# D1 dumps — contain IPs and weak user IDs, never commit
analytics-worker/backups/

# Anthropic Serena tool cache
.serena/
